# Generated / local-only artifacts (do not commit)
*.db

# Local data (may contain personal/sensitive info)
data/backups/
data/uploads/
data/exports/

# Terraform local cache + state (may contain secrets)
infra/.terraform/
infra/terraform.tfstate
infra/terraform.tfstate.*

# Environment files (contain secrets)
.env
.env.local
.env.production
.env.*.local

# Python
__pycache__/
*.pyc
.pytest_cache/

# Node
node_modules/
.next/

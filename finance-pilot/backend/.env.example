# ─── GCP Project ───
PROJECT_ID=your-gcp-project-id
FIREBASE_PROJECT_ID=your-firebase-project-id

# ─── Authentication & Authorization ───
REQUIRE_AUTH_FOR_DATA=true
TENANT_REQUIRED=true
TENANT_HEADER_NAME=X-Tenant-ID
DEFAULT_TENANT_ID=default

# ─── Email lists (comma-separated) ───
LEGACY_SHARED_EMAILS=
PREMIUM_EMAILS=
ADMIN_EMAILS=

# ─── CORS (comma-separated origins) ───
CORS_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Tenant-ID

# ─── Upload limits ───
MAX_UPLOAD_SIZE_BYTES=10485760

# ─── Local development ───
USE_SQLITE=false
USE_MOCK_DATA=false

# ─── Workspace ───
AUTO_JOIN_LEGACY_WORKSPACE=true
DEFAULT_LEGACY_MEMBER_LIMIT=2

# ─── Rate Limiting ───
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ─── Logging ───
LOG_LEVEL=INFO

# ─── Owners (comma-separated names of people sharing expenses) ───
OWNERS=Victor,Larissa

# ─── Cache ───
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300

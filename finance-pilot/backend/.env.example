# ─── GCP Project ───
PROJECT_ID=your-gcp-project-id
FIREBASE_PROJECT_ID=your-firebase-project-id

# ─── Authentication & Authorization ───
REQUIRE_AUTH_FOR_DATA=true
TENANT_REQUIRED=true
TENANT_HEADER_NAME=X-Tenant-ID
DEFAULT_TENANT_ID=default

# ─── Email lists (comma-separated) ───
PREMIUM_EMAILS=
ADMIN_EMAILS=

# ─── CORS (comma-separated origins) ───
CORS_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Tenant-ID

# ─── Upload limits ───
MAX_UPLOAD_SIZE_BYTES=10485760

# ─── Local development ───
USE_SQLITE=false
USE_MOCK_DATA=false

# ─── Rate Limiting ───
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ─── Logging ───
LOG_LEVEL=INFO

# ─── Cache ───
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300

# ─── Gemini (PDF Extraction) ───
# Required for PDF extraction via Gemini Flash 2.5
# Get your key at https://aistudio.google.com/apikey
# If using GCP service account auth, this is not needed
GOOGLE_API_KEY=

# ─── Mercado Pago (Billing) ───
# Required for subscription billing. Get credentials at https://www.mercadopago.com.br/developers
# Without this, billing runs in stub mode (no real payments)
MERCADO_PAGO_ACCESS_TOKEN=
BILLING_BACK_URL=http://localhost:3000/workspace
